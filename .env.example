# ============================================================
# 主模型（对话、工具调用）
# 支持任何 OpenAI 兼容 API：DashScope / DeepSeek / GLM / 自部署
# ============================================================
LLM_API_KEY=sk-你的key
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 常用配置示例：
# DashScope:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.6-plus
# DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1                       LLM_MODEL=deepseek-v4-flash
# 海尔 GLM:   LLM_BASE_URL=https://modelapi-test.haier.net/model/v1          LLM_MODEL=glm-5-fp8

# ============================================================
# 轻量模型（记忆召回、上下文压缩、wiki 更新等 side query）
# 不设置则复用主模型
# ============================================================
# SIDE_LLM_API_KEY=sk-你的key
# SIDE_LLM_MODEL=qwen3.5-flash
# SIDE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================================
# 飞书机器人（不配置则只能用 CLI）
# ============================================================
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx

# 日志级别: debug / info / warn / error
# LOG_LEVEL=info
