# LLM Provider（默认 dashscope；可选 deepseek）
# OFFICE_AGENT_LLM_PROVIDER=dashscope
# OFFICE_AGENT_LLM_PROVIDER=deepseek

# 阿里云百炼平台 API Key（dashscope provider 必填；语音转文字也依赖它）
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-你的key

# 可选：模型选择（默认 qwen-plus）
# 可选值：qwen-plus / qwen-max / qwen-turbo / qwen3.5-flash
# 图片识别需要支持视觉的模型，例如 qwen-vl-plus / qwen-vl-max（以 DashScope 当前可用模型为准）
DASHSCOPE_MODEL=qwen-plus

# 可选：DeepSeek V4 API（deepseek provider 必填）
# 官方 API 文档当前公开的是文本/工具调用能力；未公开图片输入 API。
# DEEPSEEK_API_KEY=sk-你的deepseek-key
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_THINKING=enabled
# DEEPSEEK_REASONING_EFFORT=high

# 可选：飞书机器人 WebSocket 通道
# 推荐多用户写法：.env 只指向 JSON，具体 app/user/cliProfile 写在 feishu-users.json。
# 适合 1 个以上用户，避免用户 2 误用用户 1 的 lark-cli 授权。
# 可复制 feishu-users.example.json 为 feishu-users.json 后填写真实 app 和 open_id。
# FEISHU_MULTI_USER_CONFIG=./feishu-users.json

# 兼容单用户旧写法：只有一个飞书 app 和一个 CLI profile 时可用。
# 在飞书开放平台创建自建应用后获取；FEISHU_CLI_PROFILE 对应本机 lark-cli --profile 名称。
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_CLI_PROFILE=default

# 可选：临时恢复旧的项目内飞书 SDK 工具（默认关闭，推荐继续使用 LarkCli）
# OFFICE_AGENT_LEGACY_FEISHU_TOOLS=1

# 可选：禁用 lark-cli 代理探测/使用。WSL 下遇到代理 EOF/502 时建议开启。
# LARK_CLI_NO_PROXY=1

# 可选：日志级别（默认 info）
# 可选值：debug / info / warn / error
# LOG_LEVEL=info

# 可选：日志目录（默认当前工程目录 ./logs）
# OFFICE_AGENT_LOG_DIR=./logs
