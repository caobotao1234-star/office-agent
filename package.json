{
  "name": "office-agent",
  "version": "0.1.0",
  "description": "Office Agent - AI-powered office assistant for task management and information tracking",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "oa": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli/index.ts",
    "feishu": "tsx src/server/feishu-bot.ts",
    "chat": "tsx src/cli/index.ts chat",
    "ask": "tsx src/cli/index.ts ask",
    "lark": "lark-cli",
    "lark:auth": "lark-cli auth login --recommend --domain all",
    "lark:status": "lark-cli auth status",
    "lark:doctor": "lark-cli doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-agent",
    "office-assistant",
    "task-management"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@larksuite/cli": "^1.0.38",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "cron-parser": "^5.5.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@clack/prompts": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
